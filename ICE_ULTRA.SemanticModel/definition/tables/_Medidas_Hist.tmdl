	measure Qtd_Especifica_Vendedor = ```
			
			    CALCULATE(
			        SUM(Fato_Vendas_Hist_Winthor[QUANTIDADE]),
			        (
			            -- Condição para o Produto 8452 com preço acima de 10.50
			            (Dim_Produtos[prd_Produto_int_PK] = 15165 && Fato_Vendas_Hist_Winthor[VLRUNITARIO] > 59.50)
			            /*||
			            -- Condição para o Produto 15142 com preços específicos
			            (Dim_Produtos[prd_Produto_int_PK] = 15142 && Fato_Vendas_Hist_Winthor[VLRUNITARIO] IN { 10.50, 12.00, 15.00 })*/
			        )
			    )
			
